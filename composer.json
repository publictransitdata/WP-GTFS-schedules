{
	"name": "publictransitdata/gtfs-timetables",
	"description": "WordPress plugin that shows public transport departure boards and stop timetables from a GTFS feed.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"wp-coding-standards/wpcs": "^3.4",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpstan/phpstan": "^2.3",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpunit/phpunit": "^10.5"
	},
	"minimum-stability": "alpha",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.0"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	}
}

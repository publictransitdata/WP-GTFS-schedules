* text=auto eol=lf

# Development files: left out of release archives (git archive, GitHub zip downloads).
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/tests export-ignore
/vendor export-ignore
/README.md export-ignore
/.wordpress-org export-ignore

# WordPress.org delivers translations from translate.wordpress.org; the release ships only the template.
/languages/*.po export-ignore
/languages/*.mo export-ignore
/languages/*.l10n.php export-ignore
/languages/*.json export-ignore

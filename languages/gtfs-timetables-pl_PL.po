msgstr "Poprzedni dzień"

#: templates/timetable.php:28
msgid "Next day"
msgstr "Następny dzień"

#: templates/timetable.php:32
msgid "No departures on this day."
msgstr "Brak odjazdów w tym dniu."

#: blocks/line/editor.js:21
msgid "How this page works"
msgstr "Jak działa ta strona"

#: blocks/line/editor.js:22
msgid "Every Lines block on the site links to the page with this block, adding the chosen line to the address."
msgstr "Każdy blok „Linie” w witrynie prowadzi do strony z tym blokiem i dodaje wybraną linię do adresu."

#: blocks/line/editor.js:23
msgid "The preview shows the first line of the feed. Without a line in the address, visitors see the list of all lines."
msgstr "Podgląd pokazuje pierwszą linię z feedu. Gdy w adresie nie ma linii, odwiedzający widzą listę wszystkich linii."

#: blocks/lines/editor.js:18
msgid "Display"
msgstr "Wygląd"

#: blocks/lines/editor.js:20
msgid "Show"
msgstr "Pokazuj"

#: blocks/lines/editor.js:23
msgid "Line numbers"
msgstr "Numery linii"

#: blocks/lines/editor.js:24
msgid "Line numbers with destinations"
msgstr "Numery linii z kierunkami"

#: blocks/lines/editor.js:29
msgid "One tab per transport mode"
msgstr "Osobna karta dla każdego środka transportu"

#: blocks/lines/editor.js:34
msgid "Night lines in their own group"
msgstr "Linie nocne w osobnej grupie"

#: blocks/lines/editor.js:35
msgid "Lines named N1, N8… are listed together after the other lines."
msgstr "Linie o nazwach N1, N8… są pokazywane razem, po pozostałych liniach."

#: blocks/lines/editor.js:40
msgid "Group heading level"
msgstr "Poziom nagłówków grup"

#: blocks/lines/editor.js:56
msgid "Transport modes"
msgstr "Środki transportu"

#: blocks/lines/editor.js:57
msgid "Tick the modes to show. With none ticked, the block shows them all."
msgstr "Zaznacz środki transportu do pokazania. Jeśli nic nie zaznaczysz, blok pokaże wszystkie."

#: blocks/line/block.json
msgctxt "block title"
msgid "Line timetable"
msgstr "Rozkład linii"

#: blocks/line/block.json
msgctxt "block description"
msgid "The line a visitor chose in a Lines block. Put it on one page: every Lines block on the site links there."
msgstr "Linia wybrana przez odwiedzającego w bloku „Linie”. Umieść go na jednej stronie: wszystkie bloki „Linie” w witrynie prowadzą właśnie tam."


#. Plugin Name of the plugin
#: ptd-gtfs-schedules.php:3
msgid "PTD GTFS Schedules"
msgstr "PTD GTFS Schedules"

#. Plugin URI of the plugin
#: ptd-gtfs-schedules.php:4
msgid "https://github.com/publictransitdata/WP-GTFS-schedules"
msgstr "https://github.com/publictransitdata/WP-GTFS-schedules"

#. Description of the plugin
#: ptd-gtfs-schedules.php:5
msgid "Shows public transport schedules from a GTFS feed."
msgstr "Показує розклади громадського транспорту з GTFS-фіду."

#. Author of the plugin
#: ptd-gtfs-schedules.php:9
msgid "PUBLICTRANSITDATA.NET"
msgstr "PUBLICTRANSITDATA.NET"

#. Author URI of the plugin
#: ptd-gtfs-schedules.php:10
msgid "https://publictransitdata.net/"
msgstr "https://publictransitdata.net/"

#. translators: %s: maximum upload size, e.g. "64 MB"
#: src/Admin/FeedUpload.php:82
#, php-format
msgid "The file is larger than this site accepts (%s). Import it from a URL or with WP-CLI instead."
msgstr "Файл більший, ніж дозволяє цей сайт (%s). Імпортуйте його використовуючи посилання на нього або через WP-CLI."

#: src/Admin/FeedUpload.php:97
msgid "Choose a GTFS .zip file first."
msgstr "Спершу виберіть файл GTFS у форматі .zip."

#. translators: %d: PHP upload error code
#: src/Admin/FeedUpload.php:101
#, php-format
msgid "The upload failed (PHP error %d)."
msgstr "Не вдалося завантажити файл (помилка PHP %d)."

#: src/Admin/FeedUpload.php:109
msgid "The file is not a .zip archive. A GTFS feed is published as a .zip of .txt files."
msgstr "Файл не є архівом .zip. Фід GTFS має бути фалом .zip з файлами .txt."

#: src/Admin/ImportAjax.php:69
msgid "You are not allowed to import feeds."
msgstr "У вас немає прав на імпорт фідів."

#: src/Admin/SettingsPage.php:78
msgid "Settings"
msgstr "Налаштування"

#: src/Admin/SettingsPage.php:93
#: src/Admin/SettingsPage.php:383
msgid "Report a problem or suggest an idea"
msgstr "Повідомити про проблему або запропонувати ідею"

#. translators: %s: version number of the plugin
#: src/Admin/SettingsPage.php:114
#, php-format
msgid "Version %s"
msgstr "Версія %s"

#: src/Admin/SettingsPage.php:122
msgid "Sections"
msgstr "Розділи"

#: src/Admin/SettingsPage.php:152
#: src/Admin/SettingsPage.php:341
msgid "Feed and import"
msgstr "Фід та імпорт"

#: src/Admin/SettingsPage.php:153
#: src/Admin/SettingsPage.php:288
msgid "Find a stop"
msgstr "Пошук зупинки"

#: src/Admin/SettingsPage.php:154
#: src/Admin/SettingsPage.php:355
msgid "Getting started"
msgstr "Як почати"

#: src/Admin/SettingsPage.php:170
msgid "(opens in a new tab)"
msgstr "(відкривається в новій вкладці)"

#: src/Admin/SettingsPage.php:178
msgid "Feed"
msgstr "Фід"

#: src/Admin/SettingsPage.php:183
msgid "Feed URL"
msgstr "Посилання на фід"

#: src/Admin/SettingsPage.php:186
msgid "Link to the GTFS .zip published by the transport operator."
msgstr "Посилання на архів GTFS .zip, який публікує перевізник чи оператор."

#: src/Admin/SettingsPage.php:190
msgid "Update automatically"
msgstr "Оновлювати автоматично"

#: src/Admin/SettingsPage.php:197
msgid "Runs at night through WP-Cron. On sites with little traffic, set up a real cron job for wp-cron.php or use WP-CLI: wp ptd-gtfs-schedules import"
msgstr "Запускається вночі через WP-Cron. На сайтах із невеликою відвідуваністю налаштуйте справжнє завдання cron для wp-cron.php або використовуйте WP-CLI: wp ptd-gtfs-schedules import"

#: src/Admin/SettingsPage.php:201
msgid "Data source credit"
msgstr "Джерело даних"

#: src/Admin/SettingsPage.php:204
msgid "Shown under timetables. Many open data licences require crediting the publisher, e.g. \"Data: City transport authority, CC BY 4.0\". Leave empty to show nothing."
msgstr "Відображається під розкладами. Деякі ліцензії відкритих даних вимагають зазначати джерело, наприклад «Дані: міське управління транспорту, CC BY 4.0». Залиште порожнім, щоб нічого не відображати."

#: src/Admin/SettingsPage.php:220
msgid "Import"
msgstr "Імпорт"

#. translators: 1: date and time, 2: time zone
#: src/Admin/SettingsPage.php:227
#, php-format
msgid "Current data imported %1$s. Feed time zone: %2$s."
msgstr "Поточні дані імпортовано %1$s. Часовий пояс фіду: %2$s."

#: src/Admin/SettingsPage.php:236
msgid "This feed describes some trips with frequencies.txt (\"every 10 minutes\"). Those trips are not shown yet."
msgstr "Частину рейсів у цьому фіді описано через frequencies.txt («кожні 10 хвилин»). Такі рейси поки не відображаються."

#: src/Admin/SettingsPage.php:246
msgid "Uploading the file…"
msgstr "Завантаження файлу…"

#: src/Admin/SettingsPage.php:249
msgid "Import from feed URL"
msgstr "Імпортувати з посилання"

#: src/Admin/SettingsPage.php:253
msgid "Or upload a GTFS .zip file:"
msgstr "Або завантажте файл GTFS .zip:"

#: src/Admin/SettingsPage.php:256
msgid "Upload and import"
msgstr "Завантажити й імпортувати"

#. translators: %s: maximum upload size, e.g. "64 MB"
#: src/Admin/SettingsPage.php:262
#, php-format
msgid "Maximum file size: %s. For larger feeds use the feed URL or WP-CLI: wp ptd-gtfs-schedules import --file=feed.zip"
msgstr "Максимальний розмір файлу: %s. Для більших фідів використовуйте посилання або WP-CLI: wp ptd-gtfs-schedules import --file=feed.zip"

#: src/Admin/SettingsPage.php:267
msgid "Automatic updates import from the feed URL and will replace data from an uploaded file."
msgstr "Автоматичне оновлення імпортує фід за посиланням і замінить дані із завантаженого файлу."

#: src/Admin/SettingsPage.php:271
msgid "Re-import even if the feed has not changed"
msgstr "Імпортувати повторно, навіть якщо фід не змінився"

#: src/Admin/SettingsPage.php:289
msgid "Each stop has shortcodes you can paste into any page: one for its next departures, one for its timetable."
msgstr "Кожна зупинка має шорткоди, які можна вставити на будь-яку сторінку: один для найближчих відправлень, другий для розкладу."

#: src/Admin/SettingsPage.php:293
#: src/Admin/SettingsPage.php:294
msgid "Stop name, code or id"
msgstr "Назва, код або ID зупинки"

#: src/Admin/SettingsPage.php:295
msgid "Search"
msgstr "Шукати"

#: src/Admin/SettingsPage.php:299
msgid "No stops found."
msgstr "Зупинок не знайдено."

#: src/Admin/SettingsPage.php:306
msgid "Stop"
msgstr "Зупинка"

#: src/Admin/SettingsPage.php:307
msgid "Code"
msgstr "Код"

#: src/Admin/SettingsPage.php:308
msgid "Shortcodes"
msgstr "Скорочення"

#: src/Admin/SettingsPage.php:317
msgid "station, includes all its platforms"
msgstr "станція, разом з усіма її платформами"

#: src/Admin/SettingsPage.php:337
msgid "Import the timetable"
msgstr "Імпортуйте розклад"

#. translators: %s: link to the "Feed and import" section
#: src/Admin/SettingsPage.php:340
#, php-format
msgid "In %s, enter the public address of the GTFS feed or upload its .zip file, and import it. A feed imported from its address can then be updated automatically."
msgstr "У розділі «%s» вкажіть публічну адресу GTFS-фіду або завантажте його файл .zip, і імпортуйте. Фід, імпортований з адреси, плагін може оновлювати автоматично."

#: src/Admin/SettingsPage.php:345
msgid "Add the Lines block"
msgstr "Додайте блок маршрутів"

#: src/Admin/SettingsPage.php:346
msgid "Add the Lines block to a page, for example the home page. It shows every line, grouped by transport mode."
msgstr "Додайте блок «Маршрути» на сторінку, наприклад на головну. Він відобразить всі маршрути, згруповані за типом транспорту."

#: src/Admin/SettingsPage.php:349
msgid "Create a page for timetables"
msgstr "Створіть окрему сторінку з розкладами"

#: src/Admin/SettingsPage.php:350
msgid "Create one page with the Line timetable block. Every Lines block on the site links there, and it shows the route and timetables of the chosen line."
msgstr "Створіть окрему сторінку з блоком «Розклади маршрутів». Усі блоки «Маршрути» на сайті ведуть туди, а вона відображає маршрут і його розклади."

#: src/Admin/SettingsPage.php:381
msgid "Problems and ideas"
msgstr "Проблеми та ідеї"

#: src/Admin/SettingsPage.php:382
msgid "Something does not work, or a feature is missing? Open an issue on GitHub: every report helps us make the plugin better."
msgstr "Щось не працює або бракує якоїсь фічі? Створіть issue на GitHub: кожне зголошення допомагає зробити плагін кращим."

#: src/Admin/SettingsPage.php:387
msgid "Contact"
msgstr "Контакти"

#: src/Admin/SettingsPage.php:398
msgid "PTD GTFS Schedules by Public Transit Data."
msgstr "PTD GTFS Schedules від Public Transit Data."


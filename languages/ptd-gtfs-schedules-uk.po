msgstr "Частина рейсів починається деінде й виїжджає на маршрут на зупинці %s"

#: templates/line.php:122
msgid "Some trips carry on to"
msgstr "Частина рейсів їде далі до"

#: templates/line.php:123
msgid "Some trips start further away, at"
msgstr "Частина рейсів починається раніше, на"


#: src/Import/BatchInsert.php:54
#, php-format
msgid "Could not write to %1$s: %2$s"
msgstr "Не вдалося записати в %1$s: %2$s"

#: src/Import/Importer.php:48
msgid "Another import is running. Try again when it has finished."
msgstr "Інший імпорт уже триває. Спробуйте знову, коли він завершиться."


msgstr "Numery linii"

#: blocks/lines/editor.js:24
msgid "Line numbers with destinations"
msgstr "Numery linii z kierunkami"

#: blocks/lines/editor.js:29
msgid "One tab per transport mode"
msgstr "Osobna karta dla każdego środka transportu"

#: blocks/lines/editor.js:34
msgid "Night lines in their own group"
msgstr "Linie nocne w osobnej grupie"

#: blocks/lines/editor.js:35
msgid "Lines named N1, N8… are listed together after the other lines."
msgstr "Linie o nazwach N1, N8… są pokazywane razem, po pozostałych liniach."

